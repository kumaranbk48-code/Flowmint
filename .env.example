# ==============================================================================
# FlowMint Environment Configuration Template (.env.example)
# Copy this file to .env.local and populate with your production credentials.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# 1. Google OAuth Client ID (Public - configured in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 2. Supabase Configuration (PostgreSQL Database & Auth)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Google Gemini AI API Key (Multimodal Voice Transcription & Parsing)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-google-ai-studio-gemini-api-key

# 4. REQUIRED in production: HMAC session secret (at least 32 random characters).
#    There is no fallback any more: without it every login fails and every session is rejected.
#    Generate one with:  openssl rand -base64 48
SESSION_SECRET=your-random-secret-of-at-least-32-characters

# 5. Public site URL, used as the target of password-reset emails (never taken from request headers).
#    Must also be listed under Supabase -> Authentication -> URL Configuration -> Redirect URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 6. Production only: if your host does not set x-vercel-forwarded-for / cf-connecting-ip / x-real-ip,
#    make sure its proxy appends the real client IP as the LAST X-Forwarded-For entry (used for rate limiting).
